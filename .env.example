# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Token opcional para proteger o endpoint público que recebe orçamentos do WhatsApp via n8n/Evolution.
# Se configurado, envie o mesmo valor no header x-lablayer-webhook-token.
WHATSAPP_INGEST_TOKEN="seu_token_seguro_aqui"

# Token obrigatório para acessar a API administrativa de leitura de dados.
# Envie no header x-lablayer-admin-token ou Authorization: Bearer <token>.
ADMIN_API_TOKEN="seu_token_admin_aqui"

# ==========================================
# INTEGRAÇÕES DE MARKETPLACE E E-COMMERCE
# ==========================================

# MERCADO LIVRE
# Crie um app em: https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID="seu_client_id_aqui"
ML_CLIENT_SECRET="seu_client_secret_aqui"

# SHOPEE
# Crie um app no Shopee Open Platform: https://open.shopee.com/
SHOPEE_PARTNER_ID="seu_partner_id_aqui"
SHOPEE_PARTNER_KEY="sua_partner_key_aqui"

# SHOPIFY
# Crie um Custom App no admin da sua loja Shopify e gere um Admin API Access Token
SHOPIFY_STORE_URL="sua-loja.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_seu_token_aqui"

# WOOCOMMERCE
# Gere as chaves em WooCommerce > Configurações > Avançado > REST API
WOOCOMMERCE_URL="https://seusite.com.br"
WOOCOMMERCE_CONSUMER_KEY="ck_sua_chave_aqui"
WOOCOMMERCE_CONSUMER_SECRET="cs_seu_secret_aqui"

# Bucket privado para arquivos gerenciados (homologar IAM e storage.rules antes de liberar)
FIREBASE_STORAGE_BUCKET=
