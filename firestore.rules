rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: tenants
    // Document ID: {tenantId} (Must match owner's UID)
    // Fields:
    //   - ownerUid: string (required, immutable)
    //   - companyName: string (required, max 100 chars)
    //   - plan: string (required, enum: ['free', 'pro', 'enterprise'])
    //   - createdAt: string (required, immutable)
    //
    // Subcollections under tenants/{tenantId}:
    //   - products
    //   - printers
    //   - filaments
    //   - orders
    //   - transactions
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.get('superadmin', false) == true;
    }

    function isTenantOwner(tenantId) {
      return isAuthenticated() && request.auth.uid == tenantId &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('status', 'active') != 'inactive' && (
        isTenantOwner(tenantId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    function legacyInventory(tenantId) {
      return !exists(/databases/$(database)/documents/tenants/$(tenantId)/inventoryControl/state) ||
        get(/databases/$(database)/documents/tenants/$(tenantId)/inventoryControl/state).data.phase == 'legacy';
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isPositiveNumber(field) {
      return request.resource.data[field] is number && request.resource.data[field] >= 0;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidTenant(tenantId) {
      let allowedFields = ['ownerUid', 'companyName', 'plan', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(allowedFields) &&
             request.resource.data.ownerUid == tenantId &&
             isValidString('companyName', 1, 100) &&
             request.resource.data.plan in ['free', 'pro', 'enterprise'] &&
             request.resource.data.createdAt is string;
    }

    function isValidProduct() {
      return hasRequiredFields(['name', 'status']) &&
             isValidString('name', 1, 100) &&
             (!('baseSku' in request.resource.data) || isValidString('baseSku', 0, 50)) &&
             request.resource.data.status in ['ativo', 'inativo', 'desenvolvimento'];
    }

    function isValidSupply() {
      let allowedFields = ['name', 'category', 'quantity', 'unit', 'costPerUnit', 'minStock', 'purchaseDate', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['name', 'quantity', 'unit', 'costPerUnit', 'createdAt']) &&
             isValidString('name', 1, 100) &&
             isValidString('unit', 1, 20) &&
             isPositiveNumber('quantity') &&
             isPositiveNumber('costPerUnit') &&
             (!('purchaseDate' in request.resource.data) || request.resource.data.purchaseDate is string) &&
             request.resource.data.createdAt is string;
    }

    function isValidPrinter() {
      let allowedFields = ['name', 'model', 'acquisitionCost', 'lifespanHours', 'usedHours', 'maintenanceBudget', 'powerConsumption', 'createdAt', 'status', 'lifespanMonths', 'purchaseDate'];
      let requiredFields = ['name', 'model', 'acquisitionCost', 'lifespanHours', 'maintenanceBudget', 'powerConsumption', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(requiredFields) &&
             isValidString('name', 1, 100) &&
             isValidString('model', 0, 100) &&
             isPositiveNumber('acquisitionCost') &&
             isPositiveNumber('lifespanHours') &&
             (!('usedHours' in request.resource.data) || isPositiveNumber('usedHours')) &&
             isPositiveNumber('maintenanceBudget') &&
             isPositiveNumber('powerConsumption') &&
             (!('status' in request.resource.data) || request.resource.data.status in ['operacional', 'manutenção', 'inativa']) &&
             request.resource.data.createdAt is string;
    }

    function isValidFilament() {
      let allowedFields = ['sku', 'material', 'color', 'colorHex', 'brand', 'lineType', 'diameter', 'pricePerKg', 'stockKg', 'initialStockKg', 'status', 'createdAt', 'purchaseDate', 'store', 'supplierId', 'purchaseHistory'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['material', 'color', 'pricePerKg', 'stockKg']) &&
             (!('sku' in request.resource.data) || isValidString('sku', 0, 50)) &&
             isValidString('material', 1, 50) &&
             isValidString('color', 1, 100) &&
             isPositiveNumber('pricePerKg') &&
             isPositiveNumber('stockKg') &&
             (!('initialStockKg' in request.resource.data) || isPositiveNumber('initialStockKg')) &&
             (!('createdAt' in request.resource.data) || request.resource.data.createdAt is string) &&
             (!('store' in request.resource.data) || isValidString('store', 0, 100)) &&
             (!('supplierId' in request.resource.data) || isValidString('supplierId', 0, 100));
    }

    function isValidSupplier() {
      let allowedFields = ['name', 'phone', 'address', 'notes', 'status', 'createdAt', 'updatedAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['name']) &&
             isValidString('name', 1, 100) &&
             (!('phone' in request.resource.data) || isValidString('phone', 0, 30)) &&
             (!('address' in request.resource.data) || isValidString('address', 0, 300)) &&
             (!('notes' in request.resource.data) || isValidString('notes', 0, 500)) &&
             (!('status' in request.resource.data) || request.resource.data.status in ['ativo', 'inativo']) &&
             (!('createdAt' in request.resource.data) || request.resource.data.createdAt is string);
    }

    function isValidOrder() {
      let allowedFields = ['orderNumber', 'date', 'productName', 'channelName', 'customerName', 'customerPhone', 'customerNotes', 'status', 'quantity', 'soldPrice', 'fees', 'realCost', 'realProfit', 'costSource', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['orderNumber', 'date', 'productName', 'channelName', 'status', 'quantity', 'soldPrice', 'fees', 'realCost', 'realProfit', 'createdAt']) &&
             isValidString('orderNumber', 1, 50) &&
             isValidString('date', 1, 50) &&
             isValidString('productName', 1, 100) &&
             isValidString('channelName', 1, 50) &&
             (!('customerName' in request.resource.data) || isValidString('customerName', 0, 120)) &&
             (!('customerPhone' in request.resource.data) || isValidString('customerPhone', 0, 40)) &&
             (!('customerNotes' in request.resource.data) || isValidString('customerNotes', 0, 500)) &&
             request.resource.data.status in ['pago', 'produzindo', 'enviado'] &&
             isPositiveNumber('quantity') &&
             isPositiveNumber('soldPrice') &&
             isPositiveNumber('fees') &&
             isPositiveNumber('realCost') &&
             (!('costSource' in request.resource.data) || request.resource.data.costSource == 'manual-confirmed') &&
             request.resource.data.realProfit is number && // Profit can be negative
             request.resource.data.createdAt is string;
    }

    function isValidTransaction() {
      let allowedFields = ['date', 'description', 'type', 'category', 'amount', 'status', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(allowedFields) &&
             isValidString('date', 1, 50) &&
             isValidString('description', 1, 200) &&
             request.resource.data.type in ['entrada', 'saida'] &&
             isValidString('category', 1, 50) &&
             isPositiveNumber('amount') &&
             request.resource.data.status in ['pago', 'pendente'] &&
             request.resource.data.createdAt is string;
    }

    function isValidMarketplace() {
      let allowedFields = ['name', 'commissionPercent', 'fixedFee', 'averageShipping', 'affiliateCommission', 'payoutDays', 'status', 'createdAt', 'updatedAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['name', 'createdAt']) &&
             isValidString('name', 1, 50) &&
             (!('commissionPercent' in request.resource.data) || isPositiveNumber('commissionPercent')) &&
             (!('fixedFee' in request.resource.data) || isPositiveNumber('fixedFee')) &&
             (!('averageShipping' in request.resource.data) || isPositiveNumber('averageShipping')) &&
             (!('affiliateCommission' in request.resource.data) || isPositiveNumber('affiliateCommission')) &&
             (!('payoutDays' in request.resource.data) || isPositiveNumber('payoutDays')) &&
             (!('status' in request.resource.data) || request.resource.data.status in ['ativo', 'inativo']) &&
             request.resource.data.createdAt is string;
    }

    function isValidProductionOrder() {
      let allowedFields = ['productName', 'productId', 'modelUrl', 'tables', 'tablesCount', 'scheduledAt', 'hoursPerTable', 'totalHours', 'status', 'filaments', 'notes', 'createdAt', 'completedAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['productName', 'status', 'createdAt']) &&
             isValidString('productName', 1, 100) &&
             (!('productId' in request.resource.data) || isValidString('productId', 0, 100)) &&
             (!('tablesCount' in request.resource.data) || isPositiveNumber('tablesCount')) &&
             (!('scheduledAt' in request.resource.data) || request.resource.data.scheduledAt is string) &&
             (!('hoursPerTable' in request.resource.data) || isPositiveNumber('hoursPerTable')) &&
             (!('totalHours' in request.resource.data) || isPositiveNumber('totalHours')) &&
             request.resource.data.status in ['fila', 'produzindo', 'concluida'] &&
             (!('filaments' in request.resource.data) || request.resource.data.filaments is list) &&
             (!('tables' in request.resource.data) || request.resource.data.tables is list) &&
             (!('modelUrl' in request.resource.data) || isValidString('modelUrl', 0, 500)) &&
             (!('notes' in request.resource.data) || isValidString('notes', 0, 500)) &&
             (!('completedAt' in request.resource.data) || request.resource.data.completedAt is string) &&
             request.resource.data.createdAt is string;
    }

    function isValidCustomRequest() {
      let allowedFields = [
        'title',
        'type',
        'status',
        'sourceChannel',
        'customerName',
        'customerPhone',
        'sourceMessage',
        'description',
        'requestedQuantity',
        'productionTimeHours',
        'printerId',
        'filaments',
        'referenceImageUrl',
        'quoteMediaImageUrl',
        'quoteMediaUrl',
        'estimatedUnitCost',
        'suggestedUnitPrice',
        'quotedPrice',
        'createdAt',
        'quoteSentAt',
        'approvedAt',
        'paidAt',
        'startedAt',
        'completedAt',
        'updatedAt'
      ];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['title', 'type', 'status', 'requestedQuantity', 'productionTimeHours', 'filaments', 'updatedAt']) &&
             isValidString('title', 1, 150) &&
             request.resource.data.type in ['orcamento', 'encomenda'] &&
             request.resource.data.status in ['aguardando-orcamento', 'orcado', 'fila-producao', 'produzindo', 'finalizado'] &&
             (!('sourceChannel' in request.resource.data) || request.resource.data.sourceChannel in ['manual', 'whatsapp']) &&
             (!('customerName' in request.resource.data) || isValidString('customerName', 0, 150)) &&
             (!('customerPhone' in request.resource.data) || isValidString('customerPhone', 0, 50)) &&
             (!('sourceMessage' in request.resource.data) || isValidString('sourceMessage', 0, 10000)) &&
             (!('description' in request.resource.data) || isValidString('description', 0, 5000)) &&
             isPositiveNumber('requestedQuantity') &&
             isPositiveNumber('productionTimeHours') &&
             (!('printerId' in request.resource.data) || isValidString('printerId', 0, 100)) &&
             request.resource.data.filaments is list &&
             (!('referenceImageUrl' in request.resource.data) || request.resource.data.referenceImageUrl is string) &&
             (!('quoteMediaImageUrl' in request.resource.data) || request.resource.data.quoteMediaImageUrl is string) &&
             (!('quoteMediaUrl' in request.resource.data) || isValidString('quoteMediaUrl', 0, 2000)) &&
             (!('estimatedUnitCost' in request.resource.data) || isPositiveNumber('estimatedUnitCost')) &&
             (!('suggestedUnitPrice' in request.resource.data) || isPositiveNumber('suggestedUnitPrice')) &&
             (!('quotedPrice' in request.resource.data) || isPositiveNumber('quotedPrice')) &&
             (!('createdAt' in request.resource.data) || request.resource.data.createdAt is string) &&
             (!('quoteSentAt' in request.resource.data) || request.resource.data.quoteSentAt is string) &&
             (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt is string) &&
             (!('paidAt' in request.resource.data) || request.resource.data.paidAt is string) &&
             (!('startedAt' in request.resource.data) || request.resource.data.startedAt is string) &&
             (!('completedAt' in request.resource.data) || request.resource.data.completedAt is string) &&
             request.resource.data.updatedAt is string;
    }

    function isValidInventoryMovement() {
      let allowedFields = ['date', 'filamentId', 'filamentName', 'type', 'amount', 'reason', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(allowedFields) &&
             isValidString('date', 1, 50) &&
             isValidString('filamentId', 1, 100) &&
             isValidString('filamentName', 1, 100) &&
             request.resource.data.type in ['entrada', 'saida', 'ajuste'] &&
             isPositiveNumber('amount') &&
             isValidString('reason', 0, 200) &&
             request.resource.data.createdAt is string;
    }

    function isValidFailureRecord() {
      let allowedFields = ['date', 'productName', 'printerName', 'type', 'materialLost', 'timeLost', 'financialLoss', 'createdAt'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(allowedFields) &&
             isValidString('date', 1, 50) &&
             isValidString('productName', 1, 100) &&
             isValidString('printerName', 1, 100) &&
             isValidString('type', 1, 50) &&
             isPositiveNumber('materialLost') &&
             isPositiveNumber('timeLost') &&
             isPositiveNumber('financialLoss') &&
             request.resource.data.createdAt is string;
    }

    function isValidLoss() {
      let allowedFields = ['date', 'type', 'weightGrams', 'filamentId', 'filamentName', 'cost', 'notes', 'productId', 'variationId'];
      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(['date', 'type', 'weightGrams', 'filamentId', 'filamentName', 'cost']) &&
             isValidString('date', 1, 50) &&
             request.resource.data.type in ['purga', 'falha', 'outro'] &&
             isPositiveNumber('weightGrams') &&
             isValidString('filamentId', 1, 100) &&
             isValidString('filamentName', 1, 100) &&
             isPositiveNumber('cost') &&
             (!('notes' in request.resource.data) || isValidString('notes', 0, 500)) &&
             (!('productId' in request.resource.data) || isValidString('productId', 0, 100)) &&
             (!('variationId' in request.resource.data) || isValidString('variationId', 0, 100));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      // Provisioning and membership/privilege changes are server-only.
      allow write: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isTenantOwner(tenantId) || isSuperAdmin();
      allow create, delete: if false;
      allow update: if (
        isTenantOwner(tenantId) && isTenantMember(tenantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName']) &&
        isValidString('companyName', 1, 100)
      ) || (
        isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'status']) &&
        request.resource.data.plan in ['free', 'pro', 'enterprise'] &&
        request.resource.data.status in ['active', 'inactive', 'past_due']
      );

      // E3: only authenticated server commands write stock and immutable events.
      match /inventoryControl/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockBalances/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockEvents/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockReservations/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockPlans/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockRuns/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockShipments/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockFulfillments/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockPurchases/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockPrinterUsage/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /stockReversals/{id} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
      }
      match /inventoryCommands/{id} { allow read, write: if false; }

      // E2 preparation: no client mutation, and no operational inventory side effects.
      match /catalogItems/{itemId} {
        allow read: if isTenantMember(tenantId);
        allow write: if false;
        match /versions/{versionId} {
          allow read: if isTenantMember(tenantId);
          allow write: if false;
        }
        match /recipes/{versionId} {
          allow read: if isTenantMember(tenantId);
          allow write: if false;
        }
      }
      match /catalogCommands/{commandId} {
        allow read, write: if false;
      }

      // Subcollections
      match /products/{productId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidProduct() && request.resource.data.get('pricingHistory', []).size() == 0 && !('latestSuggestedPrice' in request.resource.data);
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidProduct() &&
          request.resource.data.get('pricingHistory', []) == resource.data.get('pricingHistory', []) &&
          request.resource.data.get('latestSuggestedPrice', null) == resource.data.get('latestSuggestedPrice', null) &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if false;

        match /pricingSnapshots/{snapshotId} {
          allow read: if isTenantMember(tenantId);
          allow update, delete: if false;
          // Prices are computed and saved by the authenticated server command.
          allow create: if false;
        }
      }

      match /printers/{printerId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isTenantMember(tenantId) && isValidPrinter();
        allow update: if isTenantMember(tenantId) && isValidPrinter() && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.get('usedHours', 0) == resource.data.get('usedHours', 0);
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /filaments/{filamentId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidFilament();
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidFilament() && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /suppliers/{supplierId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isTenantMember(tenantId) && isValidSupplier();
        allow update: if isTenantMember(tenantId) && isValidSupplier() && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isTenantMember(tenantId);
      }

      match /orders/{orderId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidOrder() && request.resource.data.costSource == 'manual-confirmed' &&
          request.resource.data.quantity is int && request.resource.data.quantity > 0 &&
          math.abs(request.resource.data.realProfit - (request.resource.data.soldPrice - request.resource.data.fees - request.resource.data.realCost)) < 0.000001;
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidOrder() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /transactions/{transactionId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidTransaction();
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidTransaction() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /losses/{lossId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidLoss();
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidLoss();
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /supplies/{supplyId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidSupply();
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidSupply() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /marketplaces/{marketplaceId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isTenantMember(tenantId) && isValidMarketplace();
        allow update: if isTenantMember(tenantId) && isValidMarketplace() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isTenantMember(tenantId);
      }

      match /productionOrders/{orderId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidProductionOrder();
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && resource.data.status != 'concluida' && isValidProductionOrder() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId) && resource.data.status != 'concluida';
      }

      match /customRequests/{requestId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidCustomRequest();
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidCustomRequest() && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /inventoryMovements/{movementId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidInventoryMovement();
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidInventoryMovement() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /failures/{failureId} {
        allow read: if isTenantMember(tenantId);
        allow create: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidFailureRecord();
        allow update: if legacyInventory(tenantId) && isTenantMember(tenantId) && isValidFailureRecord() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if legacyInventory(tenantId) && isTenantMember(tenantId);
      }

      match /settings/{settingId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId);
      }
    }
  }
}
